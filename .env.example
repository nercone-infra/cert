# RucoNet (docker compose run --rm ruconet ruconet-hub keygen <name> in the ruconet repository)
RUCONET_PRIVATE_KEY=
RUCONET_PRESHARED_KEY=
RUCONET_HUB_PUBLIC_KEY=

# Cloudflare API token (Zone:DNS:Edit) for the DNS-01 challenge
CLOUDFLARE_API_TOKEN=

# Let's Encrypt (only used when no account exists yet)
LETSENCRYPT_EMAIL=
